}
const ROLE_ID_PREFIX_ = { STUDENT: 'STD', COACH: 'COA', PARENT: 'PAR', STAFF: 'STF' };
function clientClaimAccount(payload) {
  const lock = LockService.getScriptLock();
  lock.tryLock(LOCK_WAIT_MS);
  try {
    const role = String(payload.role || '').trim().toUpperCase();
    const tenantId = String(payload.tenantId || '').trim();
    const pin = String(payload.pin || '');
    if (!ROLE_ID_PREFIX_[role]) return { success: false, error: 'Unknown account type.' };
    if (!/^\d{4,6}$/.test(pin)) return { success: false, error: 'PIN must be 4-6 digits.' };
    const academy = sheetToObjects_(SHEETS.ACADEMIES).find(a => a.AcademyID === tenantId);
    if (!academy) return { success: false, error: 'Academy not found.' };
    if (!payload.name) return { success: false, error: 'Name is required.' };
    const pinHash = hashPin_(pin);
    let accountId;

    if (role === 'STUDENT') {
      accountId = generateSequentialId_(ROLE_ID_PREFIX_.STUDENT, SHEETS.MEMBERS, 'ArtiPlayID');
      const memberId = generateSequentialId_('M', SHEETS.MEMBERS, 'MemberID');
      const levelId = getEntryLevelId_();
      const now = new Date();
      getSheet_(SHEETS.MEMBERS).appendRow([memberId, accountId, payload.name, payload.age || '', payload.parentName || '', payload.parentContact || '', payload.parentEmail || '', payload.club || '', payload.coachId || '', levelId, tenantId, pinHash, now.toISOString(), now, 'Active']);
      getSheet_(SHEETS.SCORES).appendRow([memberId, 0, 0, 0, 0, 0, now, '', '', '', '']);
      getSheet_(SHEETS.ATTENDANCE).appendRow([memberId, 0, 0, 0, now]);
      bumpAcademyPlayerCount_(tenantId, 1);
      logActivity_(memberId, 'badge', 'Welcome to ' + academy.Name, 'Account created', '');
      appendAudit_('STUDENT_CLAIM', accountId, `${payload.name} (${memberId}) self-provisioned into ${tenantId}`);
      return { success: true, data: { accountId: accountId, memberId: memberId, tenantId: tenantId } };
    }
    if (role === 'COACH' || role === 'STAFF') {
      accountId = generateSequentialId_(ROLE_ID_PREFIX_[role], SHEETS.STAFF, 'StaffID');
      getSheet_(SHEETS.STAFF).appendRow([accountId, payload.name, payload.email || '', payload.phone || '', role === 'COACH' ? 'COACH' : 'STAFF', tenantId, '', pinHash, false, 'Active', new Date()]);
      if (role === 'COACH') syncStaffCoachToCoaches_({ StaffID: accountId, AcademyID: tenantId, Name: payload.name, Email: payload.email, Status: 'Active' });
      appendAudit_(role + '_CLAIM', accountId, `${payload.name} self-provisioned as ${role} into ${tenantId}`);
      return { success: true, data: { accountId: accountId, tenantId: tenantId } };
    }
    if (role === 'PARENT') {
      accountId = generateSequentialId_(ROLE_ID_PREFIX_.PARENT, SHEETS.PARENTS, 'ParentID');
      getSheet_(SHEETS.PARENTS).appendRow([accountId, payload.name, payload.email || '', payload.phone || '', pinHash, tenantId, 'Active', new Date()]);
      appendAudit_('PARENT_CLAIM', accountId, `${payload.name} self-provisioned into ${tenantId}`);
      return { success: true, data: { accountId: accountId, tenantId: tenantId } };
    }
    return { success: false, error: 'Unsupported role.' };
  } catch (err) { return { success: false, error: 'Server error: ' + err.message }; }
  finally { lock.releaseLock(); }
}
