/* =====================================================================================
 *  PLAYER FULL STATE — the one call the client makes to populate the entire app.
 * ===================================================================================== */
function clientGetFullState(memberId) {
  try {
    if (!memberId) return { success: false, error: 'Missing memberId.' };
    const member = sheetToObjects_(SHEETS.MEMBERS).find(m => m.MemberID === memberId);
    if (!member) return { success: false, error: 'Member not found.' };

    const scores = calculateByteSense_(memberId);
    const total = Number(scores.TotalScore) || 0;
    const levels = sheetToObjects_(SHEETS.LEVELS).filter(l => !l.TenantID || l.TenantID === member.TenantID).sort((a, b) => Number(a.MinPoints) - Number(b.MinPoints));
    const level = currentLevelForScoreIn_(levels, total);
    const next = nextLevelForScoreIn_(levels, total);
    const attendance = sheetToObjects_(SHEETS.ATTENDANCE).find(a => a.MemberID === memberId) || { AttendancePct: 0, SessionsAttended: 0, TotalSessions: 0 };
    const sessions = getSessionsForTenant_(member.TenantID).map(s => ({ id: s.SessionID, day: s.Day, date: s.Date, time: s.Time, venue: s.Venue, rsvp: getRsvpForMember_(s.SessionID, memberId) }));
    const history = sheetToObjects_(SHEETS.ATTENDANCE_LOG).filter(l => l.MemberID === memberId).sort((a, b) => new Date(b.Date) - new Date(a.Date)).map(l => ({ title: l.Title, date: l.Date, status: l.Status }));

    const defs = sheetToObjects_(SHEETS.ACHIEVEMENTS).filter(a => a.TenantID === member.TenantID);
    const unlocked = sheetToObjects_(SHEETS.MEMBER_ACHIEVEMENTS).filter(u => u.MemberID === memberId);
    const achievements = defs.map(d => {
      const u = unlocked.find(x => x.AchievementID === d.AchievementID);
      return { id: d.AchievementID, icon: d.Icon, name: d.Name, desc: d.Desc, unlocked: !!u, unlockedAt: u ? u.UnlockedAt : null };
    });

    const points = getPointsBalance_(memberId);
    const rewards = sheetToObjects_(SHEETS.REWARDS).filter(r => r.TenantID === member.TenantID || !r.TenantID)
      .map(r => ({ id: r.RewardID, icon: r.Icon, label: r.Label, cost: Number(r.Cost) || 0, desc: r.Desc || '' }));
    const wayToEarn = computeEarnActions_(member, attendance, scores, achievements);
    const pointsHistory = sheetToObjects_(SHEETS.POINTS_LEDGER).filter(l => l.MemberID === memberId)
      .sort((a, b) => new Date(b.CreatedAt) - new Date(a.CreatedAt))
      .slice(0, 30)
      .map(l => ({ reason: l.Reason, delta: Number(l.Delta) || 0, at: l.CreatedAt }));

    const storeItems = sheetToObjects_(SHEETS.STORE).filter(i => i.TenantID === member.TenantID || !i.TenantID)
      .map(i => ({ id: i.ItemID, icon: i.Icon, name: i.Name, price: Number(i.Price) || 0, forLevel: i.ForLevel || 'All levels' }));
    const storeRequests = sheetToObjects_(SHEETS.STORE_REQUESTS).filter(r => r.MemberID === memberId)
      .sort((a, b) => new Date(b.CreatedAt) - new Date(a.CreatedAt))
      .map(r => ({ itemName: r.ItemName, price: r.Price, status: r.Status, at: r.CreatedAt }));

    const announcements = sheetToObjects_(SHEETS.ANNOUNCEMENTS).filter(a => a.TenantID === member.TenantID)
      .sort((a, b) => new Date(b.PostedAt) - new Date(a.PostedAt))
      .map(a => ({ title: a.Title, body: a.Body, time: a.PostedAt }));

    const activity = getActivityForMember_(memberId, 20);
    const notifSeen = getSetting_('NOTIF_SEEN_' + memberId);
    const notifications = activity.filter(a => !notifSeen || new Date(a.at) > new Date(notifSeen)).slice(0, 10);

    const messages = getThreadsForMember_(member);

    return {
      success: true,
      data: {
