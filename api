}
function computeEarnActions_(member, attendance, scores, achievements) {
  const attended = Number(attendance.SessionsAttended) || 0;
  const total = Number(attendance.TotalSessions) || 0;
  const recognized = achievements.some(a => a.unlocked && /MVP|recognition/i.test(a.name));
  const invited = sheetToObjects_(SHEETS.POINTS_LEDGER).some(l => l.MemberID === member.MemberID && /invite/i.test(l.Reason || ''));
  const profileComplete = !!(member.ParentEmail && member.ParentContact);
  const updatedRecently = scores.UpdatedAt && ((new Date() - new Date(scores.UpdatedAt)) < 7 * 24 * 3600 * 1000);
  return [
    { label: 'Attend a training session', done: attended > 0 },
    { label: 'Perfect week attendance', done: total > 0 && attended === total },
    { label: 'Coach recognition', done: recognized },
    { label: 'Invite a teammate', done: invited },
    { label: 'Complete player profile', done: profileComplete },
    { label: 'Weekly ByteSense check-in', done: !!updatedRecently }
  ];
}
function currentLevelForScoreIn_(levels, score) { let m = levels[0] || { Name: 'Rookie', MinPoints: 0 }; levels.forEach(l => { if (score >= Number(l.MinPoints)) m = l; }); return m; }
function nextLevelForScoreIn_(levels, score) { for (const l of levels) { if (Number(l.MinPoints) > score) return l; } return null; }
function currentLevelForScore_(score) { return currentLevelForScoreIn_(sheetToObjects_(SHEETS.LEVELS).sort((a,b)=>Number(a.MinPoints)-Number(b.MinPoints)), score); }
function calculateByteSense_(memberId) {
  const row = sheetToObjects_(SHEETS.SCORES).find(s => s.MemberID === memberId);
  return row || { TrainingScore: 0, PerformanceScore: 0, BehaviorScore: 0, GrowthScore: 0, TotalScore: 0 };
}
