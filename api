/* =====================================================================================
 *  ACHIEVEMENTS — definitions live in ACHIEVEMENTS (per tenant); unlocks are
 *  computed here from real attendance/score data, never hand-set as "true" in the UI.
 * ===================================================================================== */
function evaluateAchievements_(memberId) {
  try {
    const member = sheetToObjects_(SHEETS.MEMBERS).find(m => m.MemberID === memberId);
    if (!member) return;
    const defs = sheetToObjects_(SHEETS.ACHIEVEMENTS).filter(a => a.TenantID === member.TenantID);
    const unlockedIds = sheetToObjects_(SHEETS.MEMBER_ACHIEVEMENTS).filter(u => u.MemberID === memberId).map(u => u.AchievementID);
    const log = sheetToObjects_(SHEETS.ATTENDANCE_LOG).filter(l => l.MemberID === memberId).sort((a, b) => new Date(a.Date) - new Date(b.Date));
    const scores = calculateByteSense_(memberId);
    const attendance = sheetToObjects_(SHEETS.ATTENDANCE).find(a => a.MemberID === memberId) || { AttendancePct: 0, SessionsAttended: 0 };

    const last4 = log.slice(-4);
    const streak4 = last4.length === 4 && last4.every(l => l.Status === 'Present');
    const perfectMonthCandidate = Number(attendance.AttendancePct) === 100 && Number(attendance.SessionsAttended) >= 4;
    const teamPlayer = (Number(scores.BehaviorScore) || 0) >= 85;
    const prevGrowth = Number(getSetting_('PREV_GROWTH_' + memberId)) || 0;
    const growthSpurt = ((Number(scores.GrowthScore) || 0) - prevGrowth) >= 15 && prevGrowth > 0;
    setSetting_('PREV_GROWTH_' + memberId, Number(scores.GrowthScore) || 0);

    const checks = {
      'STREAK_4': streak4,
      'PERFECT_MONTH': perfectMonthCandidate,
      'TEAM_PLAYER': teamPlayer,
      'GROWTH_SPURT': growthSpurt
      // 'MVP_SESSION' is coach-awarded only — see clientAwardAchievement
    };
    defs.forEach(def => {
      if (unlockedIds.indexOf(def.AchievementID) > -1) return;
      if (checks[def.Criteria] === true) {
        getSheet_(SHEETS.MEMBER_ACHIEVEMENTS).appendRow([memberId, def.AchievementID, new Date()]);
        awardPoints_(memberId, 50, 'Badge: ' + def.Name);
        logActivity_(memberId, 'badge', 'Badge earned: ' + def.Name, '', '+50 pts');
      }
    });
  } catch (e) { console.error('evaluateAchievements_ failed: ' + e); }
}
function clientAwardAchievement(coachId, memberId, achievementId) {
  try {
    const already = sheetToObjects_(SHEETS.MEMBER_ACHIEVEMENTS).some(u => u.MemberID === memberId && u.AchievementID === achievementId);
    if (already) return { success: false, error: 'Already unlocked.' };
    const def = sheetToObjects_(SHEETS.ACHIEVEMENTS).find(a => a.AchievementID === achievementId);
