    const handler = API_ACTIONS_[body.action];
    if (!handler) return jsonOutput_({ success: false, error: 'Unknown action: ' + body.action });
    return jsonOutput_(handler(body.payload || {}));
  } catch (err) {
    return jsonOutput_({ success: false, error: 'Server error: ' + err.message });
  }
}
function jsonOutput_(obj) { return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON); }

/* =====================================================================================
 *  HIDDEN SUPER ADMIN UNLOCK — reached only via the 5-tap gesture on the
 *  client logo. The tap gesture itself grants nothing; it only reveals a PIN
 *  field. This function is the real gate: it looks up PIN-matching staff
 *  whose Role is literally SUPER_ADMIN and Status is Active. A wrong PIN, a
 *  non-super-admin staff PIN, or an inactive account all fail here — the
 *  gesture alone can never bypass this check.
 * ===================================================================================== */
function clientSuperAdminUnlock(pin) {
  try {
    pin = String(pin || '').trim();
    if (!pin) return { success: false, error: 'Enter the Super Admin PIN.' };

    // --- Lockout check (runs before any PIN comparison) ---
    const lockUntilRaw = getSetting_('SA_LOCK_UNTIL');
    const lockUntil = lockUntilRaw ? new Date(lockUntilRaw) : null;
    if (lockUntil && lockUntil > new Date()) {
      const minsLeft = Math.ceil((lockUntil - new Date()) / 60000);
      appendAudit_('SUPER_ADMIN_UNLOCK_BLOCKED', 'unknown', `Attempt while locked out (${minsLeft}m remaining)`);
      return { success: false, error: `Too many attempts. Try again in ${minsLeft} minute(s).` };
    }

    const superAdmins = sheetToObjects_(SHEETS.STAFF).filter(s =>
      String(s.Role || '').trim().toUpperCase() === 'SUPER_ADMIN' && s.Status === 'Active');
    const match = superAdmins.find(s => pinMatches_(s.PinHash, pin));

    if (!match) {
      const failCount = (Number(getSetting_('SA_FAIL_COUNT')) || 0) + 1;
      setSetting_('SA_FAIL_COUNT', failCount);
      if (failCount >= SUPER_ADMIN_MAX_ATTEMPTS) {
        setSetting_('SA_LOCK_UNTIL', new Date(Date.now() + SUPER_ADMIN_LOCKOUT_MS).toISOString());
        setSetting_('SA_FAIL_COUNT', 0);
        appendAudit_('SUPER_ADMIN_UNLOCK_LOCKED', 'unknown', `Locked out after ${SUPER_ADMIN_MAX_ATTEMPTS} failed attempts`);
        return { success: false, error: 'Too many attempts. Try again in 15 minutes.' };
      }
      appendAudit_('SUPER_ADMIN_UNLOCK_FAILED', 'unknown', `Failed super admin unlock attempt (${failCount}/${SUPER_ADMIN_MAX_ATTEMPTS})`);
      return { success: false, error: 'Incorrect PIN.' };
    }

    // Success — clear any lockout/fail state
    setSetting_('SA_FAIL_COUNT', 0);
    setSetting_('SA_LOCK_UNTIL', '');

    const usingDefaultPin = pinMatches_(match.PinHash, DEFAULT_ADMIN_PIN);
    appendAudit_('SUPER_ADMIN_UNLOCK', match.StaffID,
      `Super admin mode entered by ${match.Name}` + (usingDefaultPin ? ' [DEFAULT PIN STILL ACTIVE]' : ''));
    return {
      success: true,
      data: {
        role: 'staff', accountId: match.StaffID, name: match.Name,
        academy: getAcademyName_(match.AcademyID), tenantId: match.AcademyID,
        staffRole: 'SUPER_ADMIN', mustChangePin: false, usingDefaultPin: usingDefaultPin
      }
    };
  } catch (err) { return { success: false, error: 'Server error: ' + err.message }; }
}

/* =====================================================================================
 *  UNIFIED LOGIN — no role picker. Tries member, then parent, then staff.
 * ===================================================================================== */
function clientUnifiedLogin(identifier, pin) {
  try {
    const id = String(identifier || '').trim();
    if (!id || !pin) return { success: false, error: 'Account ID and PIN are required.' };

    const asMember = findMemberByArtiId_(id.toUpperCase());
    if (asMember) {
      if (!pinMatches_(asMember.PinHash, pin)) return { success: false, error: 'Incorrect PIN.' };
      if (asMember.Status && asMember.Status !== 'Active') return { success: false, error: 'This account is not active.' };
      if (asMember.PinHash !== hashPin_(pin)) setMemberField_(asMember.MemberID, 'PinHash', hashPin_(pin));
      appendAudit_('PLAYER_LOGIN', asMember.ArtiPlayID, `Login by ${asMember.Name}`);
      return {
        success: true,
        data: {
          role: 'player', accountId: asMember.ArtiPlayID, memberId: asMember.MemberID,
          name: asMember.Name, academy: getAcademyName_(asMember.TenantID), tenantId: asMember.TenantID,
          coach: getCoachName_(asMember.CoachID), onboarded: getSetting_('ONBOARDED_' + asMember.MemberID) === true
        }
      };
    }

    const parent = sheetToObjects_(SHEETS.PARENTS).find(p =>
      String(p.ParentID || '').trim().toUpperCase() === id.toUpperCase() ||
      String(p.Email || '').trim().toLowerCase() === id.toLowerCase() ||
      String(p.Phone || '').trim() === id.trim());
    if (parent) {
      if (!pinMatches_(parent.PinHash, pin)) return { success: false, error: 'Incorrect PIN.' };
      if (parent.Status && parent.Status !== 'Active') return { success: false, error: 'This account is not active.' };
      const links = sheetToObjects_(SHEETS.PARENT_CHILDREN).filter(l => l.ParentID === parent.ParentID);
      const members = sheetToObjects_(SHEETS.MEMBERS);
      const children = links.map(l => {
        const m = members.find(mm => mm.MemberID === l.MemberID);
        if (!m) return null;
        const sc = calculateByteSense_(m.MemberID);
        return { id: m.ArtiPlayID, memberId: m.MemberID, name: m.Name, age: m.Age, coach: getCoachName_(m.CoachID), level: currentLevelForScore_((Number(sc.TotalScore) || 0)).Name, score: Number(sc.TotalScore) || 0 };
      }).filter(Boolean);
      appendAudit_('PARENT_LOGIN', parent.ParentID, `Login by ${parent.Name}`);
      return { success: true, data: { role: 'parent', accountId: parent.ParentID, name: parent.Name, academy: getAcademyName_(parent.TenantID), tenantId: parent.TenantID, contact: parent.Phone, children: children } };
    }

    const staff = sheetToObjects_(SHEETS.STAFF).find(s =>
      String(s.StaffID).toLowerCase() === id.toLowerCase() ||
      String(s.Email).toLowerCase() === id.toLowerCase() ||
      String(s.Phone).toLowerCase() === id.toLowerCase());
    if (staff) {
      if (!pinMatches_(staff.PinHash, pin)) return { success: false, error: 'Incorrect PIN.' };
      if (staff.Status === 'Pending') return { success: false, error: 'Your access request is still pending Admin approval.' };
      if (staff.Status !== 'Active') return { success: false, error: 'This staff account is inactive.' };
      appendAudit_('STAFF_LOGIN', staff.StaffID, `Login by ${staff.Name} (${staff.Role})`);
      return { success: true, data: { role: 'staff', accountId: staff.StaffID, name: staff.Name, academy: getAcademyName_(staff.AcademyID), tenantId: staff.AcademyID, staffRole: staff.Role, mustChangePin: staff.MustChangePin === true || String(staff.MustChangePin).toLowerCase() === 'true' } };
    }

    return { success: false, error: 'No account found with that Account ID.' };
  } catch (err) {
    return { success: false, error: 'Server error: ' + err.message };
  }
}

/* =====================================================================================
 *  onEdit — live triggers
 * ===================================================================================== */
function onEdit(e) {
  try {
    if (!e || !e.range) return;
    const sheet = e.range.getSheet();
    const name = sheet.getName();
    const row = e.range.getRow();
    if (row === 1) return;
    if (name === SHEETS.SCORES) recalcMemberScoreFromRow_(sheet, row);
    else if (name === SHEETS.ATTENDANCE) recalcAttendanceFromRow_(sheet, row);
    appendAudit_('SHEET_EDIT', getActor_(), `${name}!${e.range.getA1Notation()} -> "${e.value !== undefined ? e.value : ''}"`);
  } catch (err) { console.error('onEdit error: ' + err); }
}
function recalcMemberScoreFromRow_(sheet, row) {
  const headers = HEADERS.SCORES;
  const values = sheet.getRange(row, 1, 1, headers.length).getValues()[0];
  const obj = rowToObject_(headers, values);
  if (!obj.MemberID) return;
  const weights = getScoreWeights_();
  const total = Math.round(
    ((Number(obj.TrainingScore) || 0) * weights.training +
     (Number(obj.PerformanceScore) || 0) * weights.performance +
     (Number(obj.BehaviorScore) || 0) * weights.behavior +
     (Number(obj.GrowthScore) || 0) * weights.growth) / 100 * 10
  );
  sheet.getRange(row, headers.indexOf('TotalScore') + 1).setValue(total);
  sheet.getRange(row, headers.indexOf('UpdatedAt') + 1).setValue(new Date());
  updateMemberLevel_(obj.MemberID, total);
  evaluateAchievements_(obj.MemberID);
}
function recalcAttendanceFromRow_(sheet, row) {
  const headers = HEADERS.ATTENDANCE;
  const values = sheet.getRange(row, 1, 1, headers.length).getValues()[0];
  const obj = rowToObject_(headers, values);
  const attended = Number(obj.SessionsAttended) || 0;
  const total = Number(obj.TotalSessions) || 0;
  const pct = total > 0 ? Math.round((attended / total) * 100) : 0;
  sheet.getRange(row, headers.indexOf('AttendancePct') + 1).setValue(pct);
  sheet.getRange(row, headers.indexOf('UpdatedAt') + 1).setValue(new Date());
}
function updateMemberLevel_(memberId, totalScore) {
  const levels = sheetToObjects_(SHEETS.LEVELS).sort((a, b) => Number(a.MinPoints) - Number(b.MinPoints));
  let matched = levels[0];
  levels.forEach(l => { if (totalScore >= Number(l.MinPoints)) matched = l; });
  if (!matched) return;
  const prevLevelId = getSetting_('LAST_LEVEL_' + memberId);
  const sh = getSheet_(SHEETS.MEMBERS);
  const idx = findRowIndexByValue_(sh, 'MemberID', memberId);
  if (idx > -1) sh.getRange(idx, HEADERS.MEMBERS.indexOf('LevelID') + 1).setValue(matched.LevelID);
  if (prevLevelId && prevLevelId !== matched.LevelID) {
    logActivity_(memberId, 'bolt', 'Leveled up to ' + matched.Name, 'ByteSense', '');
  }
  setSetting_('LAST_LEVEL_' + memberId, matched.LevelID);
}
function getScoreWeights_() {
  return {
    training: Number(getSetting_('WEIGHT_TRAINING')) || 55,
    performance: Number(getSetting_('WEIGHT_PERFORMANCE')) || 20,
    behavior: Number(getSetting_('WEIGHT_BEHAVIOR')) || 15,
    growth: Number(getSetting_('WEIGHT_GROWTH')) || 10
  };
}
function recalculateAllScores() {
  const sh = getSheet_(SHEETS.SCORES);
  for (let r = 2; r <= sh.getLastRow(); r++) recalcMemberScoreFromRow_(sh, r);
  const attSh = getSheet_(SHEETS.ATTENDANCE);
  for (let r = 2; r <= attSh.getLastRow(); r++) recalcAttendanceFromRow_(attSh, r);
  appendAudit_('RECALC_ALL', getActor_(), 'Recalculated all scores/attendance via menu');
  SpreadsheetApp.getUi().alert('All ByteSense scores and attendance recalculated.');
}

/* =====================================================================================
 *  STAFF APPROVAL EMAIL (installable trigger)
 * ===================================================================================== */
function onEditInstallable(e) {
  try {
    if (!e || !e.range) return;
    const sheet = e.range.getSheet();
    if (sheet.getName() !== SHEETS.STAFF) return;
    const row = e.range.getRow();
    if (row === 1) return;
    handleStaffApprovalEdit_(sheet, row, e);
  } catch (err) { console.error('onEditInstallable error: ' + err); }
}
function handleStaffApprovalEdit_(sheet, row, e) {
  const statusCol = HEADERS.STAFF.indexOf('Status') + 1;
  if (e.range.getColumn() !== statusCol) return;
  const newStatus = String(e.value || '').trim();
  const oldStatus = String(e.oldValue || '').trim();
