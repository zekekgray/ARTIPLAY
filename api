function getEntryLevelId_() { const l = sheetToObjects_(SHEETS.LEVELS).sort((a, b) => Number(a.MinPoints) - Number(b.MinPoints)); return l.length ? l[0].LevelID : 'LVL-1'; }
function getSetting_(key) { const s = sheetToObjects_(SHEETS.SETTINGS).find(s => s.Key === key); return s ? s.Value : null; }
function setSetting_(key, value) {
