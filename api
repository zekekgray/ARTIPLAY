/* =====================================================================================
 *  COACH / STAFF FULL STATE — roster (real MEMBERS), sessions, announcements
 * ===================================================================================== */
function clientGetCoachState(coachId, tenantId) {
  try {
    const staff = sheetToObjects_(SHEETS.STAFF).find(s => s.StaffID === coachId);
    if (!staff) return { success: false, error: 'Coach/staff not found.' };
    tenantId = tenantId || staff.AcademyID;
    const members = sheetToObjects_(SHEETS.MEMBERS).filter(m => m.TenantID === tenantId && (staff.Role === 'COACH' ? m.CoachID === coachId : true));
    const allRsvps = sheetToObjects_(SHEETS.RSVPS);
    const allAttendance = sheetToObjects_(SHEETS.ATTENDANCE);
    const sessionsRaw = getSessionsForTenant_(tenantId);

    const today = sessionsRaw[0] ? (function(){
      const s = sessionsRaw[0];
      const yes = allRsvps.filter(r => r.SessionID === s.SessionID && r.Status === 'yes').length;
      return { id: s.SessionID, day: s.Day, date: s.Date, time: s.Time, venue: s.Venue, totalPlayers: members.length, rsvpYes: yes };
    })() : null;

    const roster = members.map(m => {
      const sc = calculateByteSense_(m.MemberID);
      const total = Number(sc.TotalScore) || 0;
      const att = allAttendance.find(a => a.MemberID === m.MemberID) || { AttendancePct: 0, SessionsAttended: 0, TotalSessions: 0 };
      const rsvpToday = today ? ((allRsvps.find(r => r.SessionID === today.id && r.MemberID === m.MemberID) || {}).Status || '') : '';
      return {
        memberId: m.MemberID, accountId: m.ArtiPlayID, name: m.Name,
        score: total, level: currentLevelForScore_(total).Name,
        training: Number(sc.TrainingScore) || 0, performance: Number(sc.PerformanceScore) || 0,
        behavior: Number(sc.BehaviorScore) || 0, growth: Number(sc.GrowthScore) || 0,
        trainingNote: sc.TrainingNote || '', performanceNote: sc.PerformanceNote || '', behaviorNote: sc.BehaviorNote || '', growthNote: sc.GrowthNote || '',
        attendancePct: Number(att.AttendancePct) || 0, attendanceAttended: Number(att.SessionsAttended) || 0, attendanceTotal: Number(att.TotalSessions) || 0,
        rsvpToday: rsvpToday,
        recentActivity: getActivityForMember_(m.MemberID, 4)
      };
    });

    const noRsvpCount = today ? roster.filter(r => !r.rsvpToday).length : 0;
    const lowAttendanceCount = roster.filter(r => r.attendanceTotal > 0 && r.attendancePct < 50).length;
    const unreadThreads = getCoachUnreadThreadCount_(tenantId, coachId);
    const attention = [];
    if (noRsvpCount > 0) attention.push({ icon: 'training', title: `${noRsvpCount} player${noRsvpCount>1?'s':''} haven't RSVP'd`, sub: today ? `${today.day} · ${today.date}` : '' });
    if (lowAttendanceCount > 0) attention.push({ icon: 'clock', title: `${lowAttendanceCount} player${lowAttendanceCount>1?'s':''} need attendance review`, sub: 'Below 50% attendance' });
    if (unreadThreads > 0) attention.push({ icon: 'chat', title: `${unreadThreads} unread message${unreadThreads>1?'s':''}`, sub: 'From players or parents' });

    const sessions = sessionsRaw.map(s => ({ id: s.SessionID, day: s.Day, date: s.Date, time: s.Time, venue: s.Venue,
      rsvpYes: allRsvps.filter(r=>r.SessionID===s.SessionID && r.Status==='yes').length, totalPlayers: members.length }));
    const announcements = sheetToObjects_(SHEETS.ANNOUNCEMENTS).filter(a => a.TenantID === tenantId).sort((a, b) => new Date(b.PostedAt) - new Date(a.PostedAt)).map(a => ({ title: a.Title, body: a.Body, time: a.PostedAt }));
    const achievements = sheetToObjects_(SHEETS.ACHIEVEMENTS).filter(a => a.TenantID === tenantId).map(a => ({ id: a.AchievementID, name: a.Name, icon: a.Icon }));

    const avg = (arr) => arr.length ? Math.round(arr.reduce((a,b)=>a+b,0) / arr.length) : 0;
    const development = {
      avgByteSense: avg(roster.map(r=>r.score)), avgPerformance: avg(roster.map(r=>r.performance)),
      avgBehavior: avg(roster.map(r=>r.behavior)), avgAttendance: avg(roster.map(r=>r.attendancePct)),
      avgGrowth: avg(roster.map(r=>r.growth))
    };
    const insights = roster.map(r => {
      let level = 'green', reason = 'Trending well';
      if (r.attendanceTotal > 0 && r.attendancePct < 50) { level = 'red'; reason = 'Attendance declining'; }
      else if (r.score < 60) { level = 'yellow'; reason = 'ByteSense below team average'; }
      else if (r.growth >= 80) { level = 'green'; reason = 'Strong growth'; }
      return { memberId: r.memberId, name: r.name, level, reason };
    }).filter(i => i.level !== 'green');

    const messages = getThreadsForCoach_(tenantId, coachId);

    return { success: true, data: { staffName: staff.Name, staffRole: staff.Role, academy: getAcademyName_(tenantId),
      today, roster, attention, sessions, announcements, achievements, development, insights, messages } };
  } catch (err) { return { success: false, error: 'Server error: ' + err.message }; }
}
function getCoachUnreadThreadCount_(tenantId, coachId) {
  try { return sheetToObjects_(SHEETS.MESSAGES).filter(m => m.TenantID === tenantId && m.ToID === coachId && !m.ReadAt).length; }
  catch (e) { return 0; }
}
function getThreadsForCoach_(tenantId, coachId) {
  try {
    const rows = sheetToObjects_(SHEETS.MESSAGES).filter(m => m.TenantID === tenantId && (m.ToID === coachId || m.FromID === coachId));
    const byThread = {};
    rows.forEach(m => { if(!byThread[m.ThreadID] || new Date(m.SentAt) > new Date(byThread[m.ThreadID].SentAt)) byThread[m.ThreadID] = m; });
    const members = sheetToObjects_(SHEETS.MEMBERS);
    return Object.keys(byThread).map(tid => {
      const last = byThread[tid];
      const otherId = last.FromID === coachId ? last.ToID : last.FromID;
      const member = members.find(mm => mm.MemberID === otherId);
      const unread = rows.some(m => m.ThreadID === tid && m.ToID === coachId && !m.ReadAt);
      return { id: tid, name: member ? member.Name : (last.FromName || 'Player'), last: last.Body, time: last.SentAt, unread: unread };
    }).sort((a,b)=> new Date(b.time) - new Date(a.time));
  } catch (e) { return []; }
}
function clientSendCoachMessage(threadId, coachId, body) {
  try {
    const staff = sheetToObjects_(SHEETS.STAFF).find(s => s.StaffID === coachId);
    if (!staff) return { success: false, error: 'Coach not found.' };
    const existing = sheetToObjects_(SHEETS.MESSAGES).find(m => m.ThreadID === threadId);
    const toId = existing ? (existing.FromID === coachId ? existing.ToID : existing.FromID) : '';
    getSheet_(SHEETS.MESSAGES).appendRow([Utilities.getUuid(), threadId, staff.AcademyID, coachId, staff.Name, toId, body, new Date(), '']);
    return { success: true };
  } catch (err) { return { success: false, error: 'Server error: ' + err.message }; }
}
/** Coach edits a player's category scores directly — this is the ONLY place ByteSense
 *  numbers are hand-set, and it writes to the real SCORES sheet (onEdit recalculates
 *  TotalScore/level/achievements from there — nothing is computed twice). */
function clientSaveScoreEdit(coachId, memberId, scores) {
  try {
    const sh = getSheet_(SHEETS.SCORES);
    const idx = findRowIndexByValue_(sh, 'MemberID', memberId);
    if (idx === -1) return { success: false, error: 'Score record not found.' };
    const fields = ['TrainingScore','PerformanceScore','BehaviorScore','GrowthScore','TrainingNote','PerformanceNote','BehaviorNote','GrowthNote'];
    fields.forEach(f => {
      if (scores[f] !== undefined) sh.getRange(idx, HEADERS.SCORES.indexOf(f) + 1).setValue(scores[f]);
    });
    recalcMemberScoreFromRow_(sh, idx); // also triggers achievement evaluation
    logActivity_(memberId, 'bolt', 'ByteSense updated by ' + (sheetToObjects_(SHEETS.STAFF).find(s=>s.StaffID===coachId)||{}).Name || 'your coach', '', '');
    appendAudit_('SCORE_EDIT', coachId, `${memberId} scores updated`);
    return { success: true };
  } catch (err) { return { success: false, error: 'Server error: ' + err.message }; }
}

